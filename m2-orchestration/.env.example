# M2 Airflow. Copy to .env: cp .env.example .env
# README "How to run" fills every value with one command. Letters and digits only
# (Compose treats $ and # specially). Empty values make the stack fail fast instead of using a weak default.

# --- Airflow ---
# Your Linux user id: id -u
AIRFLOW_UID=50000
# openssl rand -hex 16
AIRFLOW_DB_PASSWORD=
# Encrypts connection passwords in the metadata DB. Generate once, never change:
# openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=
# Signs API tokens: openssl rand -hex 32
AIRFLOW_JWT_SECRET=
# Web UI login (http://127.0.0.1:18080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# --- Must match other modules ---
# = POSTGRES_PASSWORD in m1-infra/.env
OLIST_PG_PASSWORD=
# = secretKey in secrets/s3.json
LAKE_S3_SECRET=
# = SERVING_WRITER_PASSWORD in m8-dashboard/.env
SERVING_WRITER_PASSWORD=
