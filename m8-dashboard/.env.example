# M8 serving DB + Metabase. README "How to run" step 3 writes this file with generated values.
# Letters and digits only.

# PostgreSQL roles created by sql/01_serving_metabase.sql: openssl rand -hex 16
# Writes the marts (also copied to m2-orchestration/.env)
SERVING_WRITER_PASSWORD=
# Metabase reads the serving DB (read-only)
BI_READER_PASSWORD=
# Metabase's own app database
METABASE_DB_PASSWORD=

# Metabase secrets: openssl rand -hex 32
# Set BEFORE the first Metabase start and never change the encryption key,
# or Metabase can no longer read its saved connections.
MB_ENCRYPTION_SECRET_KEY=
MB_SESSION_SECRET_KEY=
