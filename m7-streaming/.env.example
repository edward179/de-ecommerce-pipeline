# M7 producer: read-only Postgres login used to sample real Olist IDs (libpq PG* variables)
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=olist
PGUSER=event_producer
# openssl rand -hex 16 (must match the password given to sql/01_event_producer.sql)
PGPASSWORD=

# M7 consumer: SeaweedFS S3 user "event-writer" (see m2-orchestration/secrets/s3.json.example)
LAKE_ENDPOINT=127.0.0.1:18333
LAKE_BUCKET=olist-lake
LAKE_ACCESS_KEY=eventwriter
# openssl rand -hex 20 (must match secretKey of event-writer in s3.json)
LAKE_SECRET_KEY=
